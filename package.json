{
  "name": "waleed-zone",
  "version": "1.0.0",
  "private": true,
  "description": "Arabic app and game catalog built with Next.js, Tailwind CSS, TypeScript, and PostgreSQL.",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.cjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:downloads": "node --test tests/downloads.cjs",
    "migrate:downloads": "node scripts/migrate-downloads.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "drizzle-orm": "0.45.3",
    "next": "15.5.26",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "postcss": "8.5.28"
  }
}
