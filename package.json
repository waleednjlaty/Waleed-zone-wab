{
  "name": "waleed-zone",
  "version": "1.0.0",
  "private": true,
  "description": "Arabic app and game catalog built with Next.js, Tailwind CSS, TypeScript, and PostgreSQL.",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 tests/*.cjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:downloads": "node --test tests/downloads.cjs",
    "test:downloads:strict": "WZ_DOWNLOAD_CONTRACT_STRICT=1 node --test tests/download-contract.cjs",
    "test:storage": "node --test tests/storage*.cjs",
    "migrate:downloads": "node scripts/migrate-downloads.mjs",
    "metadata:downloads": "node scripts/download-metadata.mjs",
    "test:metadata": "node --test tests/file-metadata.cjs",
    "migrate:delivery": "node scripts/migrate-delivery.mjs",
    "migrate:release": "npm run migrate:downloads && npm run migrate:delivery && npm run migrate:runtime-security && npm run migrate:monetization && npm run migrate:download-processing",
    "migrate:runtime-security": "node scripts/migrate-runtime-security.mjs",
    "migrate:monetization": "node scripts/migrate-monetization.mjs",
    "monetization:audit": "node scripts/monetization-audit.mjs",
    "migrate:download-processing": "node scripts/migrate-download-processing.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "drizzle-orm": "0.45.3",
    "next": "15.5.26",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "postcss": "8.5.28"
  }
}
