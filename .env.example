# ============================================================
#  PostgreSQL connection string (Neon Database)
#  Use a READ-ONLY user/role for maximum security (recommended).
#  Neon free-tier example:
#    postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
# ============================================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# ============================================================
#  Public site URL (used for sitemap.xml, canonical URLs and
#  Open Graph tags). Set to your real domain in production,
#  e.g. https://waleed-zone.vercel.app
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
