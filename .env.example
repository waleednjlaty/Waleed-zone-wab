# Canonical public origin
NEXT_PUBLIC_SITE_URL=https://waleed-zone.up.railway.app
# Private PostgreSQL connection string
DATABASE_URL=
# Independent random secrets, e.g. openssl rand -hex 32
VISIT_KEY_SALT=
WEBSITE_STATS_TOKEN=
# Stable ID of an existing site_users account; unset means no session has owner rights.
# Set this only in the deployment environment, never in NEXT_PUBLIC variables.
OWNER_USER_ID=
# AdSense readiness: configure only after content policy review and approval.
# Advertising stays off unless all five gates pass, with page approval and live CMP consent.
ADSENSE_PUBLISHER_ID=
ADSENSE_CONTENT_REVIEWED=false
ADSENSE_SITE_APPROVED=false
ADSENSE_PRIVACY_READY=false
ADSENSE_ENABLED=false
# Manual detail placement only; leave empty until account/CMP approval and review.
ADSENSE_DETAIL_SLOT_ID=
ADSENSE_CMP_ID=

# Phase 3 stays disabled until explicit migration + provider/ingress/budget verification.
DIRECT_DOWNLOADS_ENABLED=false
# Exact HTTPS delivery hostnames, comma-separated (no schemes, ports or wildcards).
DOWNLOAD_ALLOWED_DELIVERY_HOSTS=
# This must be a single-IP header overwritten by the verified ingress on every hostname.
# Never choose x-forwarded-for; do not enable based on the header name alone.
DOWNLOAD_INGRESS_VERIFIED=false
DOWNLOAD_TRUSTED_IP_HEADER=
DOWNLOAD_IP_HASH_KEY=
# Optional 24-hour HMAC rotation overlap; keep old/new admission and attempt limits together.
DOWNLOAD_IP_HASH_PREVIOUS_KEY=
DOWNLOAD_IP_HASH_OVERLAP_UNTIL=

# Phase 4 private storage adapter. Empty backend keeps the registry empty.
# Values are server-only; selecting an adapter does NOT enable direct downloads.
# railway-s3 (primary) or s3 (other explicitly reviewed compatible provider).
DOWNLOAD_STORAGE_BACKEND=
# Separate operator attestation after real private-origin/Range/expiry checks.
# Valid credentials alone must not register a production adapter.
DOWNLOAD_STORAGE_PROVIDER_VERIFIED=false
# Base HTTPS endpoint, no bucket/path/query; use Railway bucket ENDPOINT.
DOWNLOAD_S3_ENDPOINT=
# Railway bucket REGION (e.g. auto); do not infer from the web service region.
DOWNLOAD_S3_REGION=
# Actual S3 BUCKET value, not Railway display name / RAILWAY_BUCKET_NAME.
DOWNLOAD_S3_BUCKET=
DOWNLOAD_S3_ACCESS_KEY_ID=
DOWNLOAD_S3_SECRET_ACCESS_KEY=
# false = virtual hosted style (current Railway); true only for a verified path style bucket.
DOWNLOAD_S3_FORCE_PATH_STYLE=false
# Railway currently lacks versioning; true only for a verified other provider.
DOWNLOAD_S3_VERSIONING_ENABLED=false
# metadata = trusted publisher's x-amz-meta-sha256 (64 lowercase hex).
# provider = canonical full-object ChecksumSHA256 from authenticated HEAD; never ETag.
DOWNLOAD_S3_CHECKSUM_SOURCE=metadata
# Each adapter operation: integer 100..2500ms; existing redemption total remains 3000ms.
DOWNLOAD_S3_TIMEOUT_MS=2500

# Operator CLI only. Empty by default; explicit loopback wz_metadata_test_<suffix> DB.
# Never falls back to DATABASE_URL and never accepts production.
DOWNLOAD_METADATA_DATABASE_URL=

# Public Files Channel reference only. No BOT_TOKEN in the website.
FILES_CHANNEL_USERNAME=
# Fallback only when both FILES_CHANNEL_* are unset. Must match the bot.
CHANNEL_USERNAME=
# Independent >=32-character random server-only signing secret.
LEGACY_DOWNLOAD_SIGNING_KEY=
# Exact hosts for pre-existing external records only.
LEGACY_DOWNLOAD_ALLOWED_HOSTS=devuploads.com,shrinkme.io,shrinkme.site
