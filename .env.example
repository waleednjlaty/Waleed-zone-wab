# PostgreSQL connection string.
# Use a dedicated read-only role for the public website whenever possible.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Canonical public origin used by metadata, sitemap, structured data and IndexNow.
# Production example:
# NEXT_PUBLIC_SITE_URL=https://waleed-zone.up.railway.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects the private statistics API. Use a long random value.
WEBSITE_STATS_TOKEN=change-this-shared-secret

# Optional separate token for POST /api/indexnow.
# If omitted, the IndexNow endpoint falls back to WEBSITE_STATS_TOKEN.
INDEXNOW_ADMIN_TOKEN=change-this-indexnow-secret

# Optional salt for one-way daily visitor analytics identifiers.
VISIT_KEY_SALT=change-this-random-salt

# Optional Bing Webmaster Tools HTML meta verification value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
